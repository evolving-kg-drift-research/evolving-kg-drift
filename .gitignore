# Virtual Environment
.venv/
venv/
ENV/

# Python cache and build metadata
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Backups (isolated from active pipeline discovery & git tracking)
backups/

# OS / Editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local Claude worktrees and tooling
.claude/

# Generated backups, test output, and coverage
*.bak
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Pipeline outputs and local execution artifacts
/runs/
/logs/
/reports/
/outputs/

# External data packages and generated data artifacts
/data/raw/
/data/discovery/
/data/stage_4_3_runs/
/data/stage_4_4_runs/
/data/stage_4_4/
/data/**/*.parquet
/data/**/*.jsonl
/data/**/*.tar
/data/**/*.zst
/data/**/*.csv

# Small metadata under data/manifests/ remains opt-in and must be staged explicitly.
# Do not add generated data artifacts by default.

# Locked held-out test data must never be tracked or discovered by the pipeline
/data/locked_test/*
!/data/locked_test/README.md
!/data/locked_test/.gitkeep
